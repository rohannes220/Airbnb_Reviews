# DS5110 Final Project, Track 4: Reviews
#
# Data targets:
#   make data       download the course-assigned frozen snapshots into data/raw/ and verify SHA-256
#   make fetch      download only (primary URL first, then the GitHub release asset fallback)
#   make verify     check every file in data/raw/ against MANIFEST.sha256
#   make manifest   (re)write MANIFEST.sha256 from the files currently in data/raw/
#   make counts     print actual row counts for the downloaded files
#
# Snapshot sources are NOT hard-coded: they must be the exact frozen snapshots from the course
# files. Set them on the command line or in an untracked local file, data/sources.mk, e.g.:
#   BUILD_BASE_URL = <course-provided URL of the folder holding the build snapshot files>
#   TEST_BASE_URL  = <course-provided URL of the folder holding the 2026-09-19 test snapshot files>
# Each base URL must serve listings.csv.gz, reviews.csv.gz, calendar.csv.gz and
# neighbourhoods.geojson directly underneath it.
#
# Fallback: if a primary download fails (or no base URL is set), the file is fetched from the
# GitHub release $(RELEASE_TAG) of $(RELEASE_REPO), where each asset is named
# <snapshot>-<file>, e.g. build-listings.csv.gz or test-reviews.csv.gz.

SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

PYTHON   ?= python3
RAW_DIR  := data/raw
MANIFEST := MANIFEST.sha256
SNAPSHOTS := build test
FILES    := listings.csv.gz reviews.csv.gz calendar.csv.gz neighbourhoods.geojson

BUILD_BASE_URL ?=
TEST_BASE_URL  ?=
RELEASE_REPO   ?= rohannes220/Airbnb_Reviews
RELEASE_TAG    ?= v0.1-proposal
RELEASE_BASE_URL ?= https://github.com/$(RELEASE_REPO)/releases/download/$(RELEASE_TAG)

-include data/sources.mk

# sha256sum on Linux, shasum on macOS.
SHA256 := $(shell command -v sha256sum >/dev/null 2>&1 && echo sha256sum || echo "shasum -a 256")
CURL   := curl --fail --location --silent --show-error --retry 3 --connect-timeout 20

.PHONY: help install data fetch verify manifest counts clean-data

help:
	@sed -n '3,8p' Makefile | sed 's/^# //'

install:
	$(PYTHON) -m pip install -r requirements.txt

data: fetch verify
	@echo "data: all snapshot files downloaded and verified."

fetch:
	@failed=0; \
	for snap in $(SNAPSHOTS); do \
	  case "$$snap" in build) base="$(BUILD_BASE_URL)";; test) base="$(TEST_BASE_URL)";; esac; \
	  mkdir -p "$(RAW_DIR)/$$snap"; \
	  for f in $(FILES); do \
	    dest="$(RAW_DIR)/$$snap/$$f"; \
	    if [ -s "$$dest" ]; then echo "skip   $$dest (already present)"; continue; fi; \
	    ok=0; \
	    if [ -n "$$base" ]; then \
	      echo "fetch  $$dest <- $$base/$$f"; \
	      if $(CURL) -o "$$dest.part" "$$base/$$f"; then ok=1; else echo "       primary download failed"; fi; \
	    else \
	      echo "fetch  $$dest: no primary URL set for the '$$snap' snapshot"; \
	    fi; \
	    if [ $$ok -eq 0 ]; then \
	      echo "       fallback <- $(RELEASE_BASE_URL)/$$snap-$$f"; \
	      if $(CURL) -o "$$dest.part" "$(RELEASE_BASE_URL)/$$snap-$$f"; then ok=1; else echo "       fallback download failed"; fi; \
	    fi; \
	    if [ $$ok -eq 1 ]; then mv "$$dest.part" "$$dest"; else rm -f "$$dest.part"; failed=1; fi; \
	  done; \
	done; \
	if [ $$failed -ne 0 ]; then \
	  echo "ERROR: some files could not be downloaded. Set BUILD_BASE_URL/TEST_BASE_URL to the course" >&2; \
	  echo "       snapshot URLs, or upload the files as assets of release $(RELEASE_TAG)." >&2; \
	  exit 1; \
	fi

verify:
	@entries=$$(grep -cv -e '^#' -e '^[[:space:]]*$$' $(MANIFEST) || true); \
	if [ "$$entries" -eq 0 ]; then \
	  echo "ERROR: $(MANIFEST) has no checksum entries yet. Place the frozen files in $(RAW_DIR)/, run" >&2; \
	  echo "       'make manifest', review the result and commit it." >&2; \
	  exit 1; \
	fi; \
	for snap in $(SNAPSHOTS); do for f in $(FILES); do \
	  if ! grep -q "  $(RAW_DIR)/$$snap/$$f$$" $(MANIFEST); then \
	    echo "ERROR: $(MANIFEST) has no entry for $(RAW_DIR)/$$snap/$$f" >&2; exit 1; \
	  fi; \
	done; done; \
	grep -v -e '^#' -e '^[[:space:]]*$$' $(MANIFEST) | $(SHA256) -c -

manifest:
	@for snap in $(SNAPSHOTS); do for f in $(FILES); do \
	  if [ ! -s "$(RAW_DIR)/$$snap/$$f" ]; then echo "ERROR: missing $(RAW_DIR)/$$snap/$$f" >&2; exit 1; fi; \
	done; done; \
	{ \
	  echo "# SHA-256 checksums of the frozen Inside Airbnb snapshots in $(RAW_DIR)/."; \
	  echo "# Generated by 'make manifest' from the downloaded files. Verify with 'make verify'."; \
	  for snap in $(SNAPSHOTS); do for f in $(FILES); do $(SHA256) "$(RAW_DIR)/$$snap/$$f"; done; done; \
	} > $(MANIFEST); \
	cat $(MANIFEST)

counts:
	@$(PYTHON) -c 'import sys, json, pandas as pd; [print(p + ": " + format(len(json.load(open(p))["features"]) if p.endswith(".geojson") else len(pd.read_csv(p, low_memory=False)), ",") + " rows") for p in sys.argv[1:]]' \
	  $(foreach s,$(SNAPSHOTS),$(foreach f,$(FILES),$(RAW_DIR)/$(s)/$(f)))

clean-data:
	rm -rf $(addprefix $(RAW_DIR)/,$(SNAPSHOTS)) $(RAW_DIR)/*/*.part
